API_ID=
API_HASH=
BOT_TOKEN=
OWNER_ID=
DATABASE_URL=postgresql://user:password@host:5432/dbname
REDIS_URL=
DEV_USERNAME=K0_MG

# Capacity and transmission
MAX_FILE_MB=500
MAX_CONCURRENT_JOBS=2
MAX_CONCURRENT_TRANSMISSIONS=4
MIN_FREE_DISK_MB=256
JOB_LOCK_TTL_SECONDS=600
WORK_DIR=/tmp
# On Railway, mount a persistent volume at /app/data and set REF_DIR=/app/data/tfps_refs
REF_DIR=./data/tfps_refs

# Processing
VERIFY_INTEGRITY=1
SMART_REENCODE=0
REENCODE_CRF=18
REENCODE_PRESET=medium
REENCODE_TIMEOUT=1800
LOW_BITRATE_KBPS=4000
COMPRESS_SHORT_SIDE=1080
# ZETA1 | ZETA2 | TIMECODE (Pulse)
PATCH_METHOD=ZETA1

# TikTok published-video comparison (/check)
QUALITY_METRIC=auto
CHECK_MAX_SECONDS=30
CHECK_MAX_DOWNLOAD_MB=300
KEEP_REFERENCE=1
CHECK_REF_MAX_MB=500
CHECK_REF_TTL_HOURS=48
YTDLP_IMPERSONATE=chrome-131
PROXY_URL=

# Telegram Stars (digital services are paid for through Telegram Stars)
STARS_VIDEO_PRICE=250
STARS_SUB_30D_PRICE=0
MAX_OPEN_STAR_INVOICES=3
STAR_INVOICE_COOLDOWN_SECONDS=30
STAR_INVOICE_TTL_HOURS=24

# Optional owner operations log (Telegram chat ID; leave empty to disable)
LOG_CHAT_ID=

EXPIRY_WARN_DAYS=3
